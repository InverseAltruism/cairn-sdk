{
  "name": "@inversealtruism/cairn-sdk",
  "version": "0.6.0",
  "description": "The Compute Substrate dApp kit: one cohesive toolkit to connect the Cairn Wallet, read the chain, the indexer and .csd names, verify self-certifying content, and resolve .csd names. Composes the published csd-* primitives.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js",
      "require": "./dist/connect.cjs"
    },
    "./indexer": {
      "types": "./dist/indexer.d.ts",
      "import": "./dist/indexer.js",
      "require": "./dist/indexer.cjs"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "require": "./dist/content.cjs"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "import": "./dist/chain.js",
      "require": "./dist/chain.cjs"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js",
      "require": "./dist/controller.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/connect.ts src/indexer.ts src/content.ts src/chain.ts src/controller.ts src/react.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome lint --max-diagnostics=none .",
    "check:dashes-paths": "node scripts/check-dashes-paths.mjs",
    "test": "node test/run.mjs",
    "test:live": "node examples/read-only.mjs && node test/e2e/e2e-read.mjs",
    "test:live:wallet": "xvfb-run -a node test/e2e/e2e-wallet-connect.mjs",
    "build:example": "node scripts/build-example.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:all": "pnpm test && pnpm test:live && pnpm test:live:wallet",
    "prepack": "pnpm build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@inversealtruism/cairnx-core": "0.2.0",
    "@inversealtruism/csd-client": "0.1.18",
    "@inversealtruism/csd-codec": "0.1.18",
    "@inversealtruism/csd-crypto": "0.1.18",
    "@inversealtruism/csd-light": "0.1.23",
    "@inversealtruism/csd-tx": "0.1.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inversealtruism/csd-siwc": "0.1.19",
    "@types/node": "22.19.20",
    "esbuild": "0.28.2",
    "playwright-core": "1.60.0",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InverseAltruism/cairn-sdk.git"
  },
  "homepage": "https://cairn-substrate.com",
  "keywords": [
    "compute-substrate",
    "csd",
    "cairn",
    "wallet",
    "dapp",
    "sdk",
    "blockchain"
  ]
}